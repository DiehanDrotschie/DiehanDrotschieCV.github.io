---
import { about, hero } from "../../data/site.js";

const base = import.meta.env.BASE_URL;
---

<div class="app-content about-app">
    <div class="about-hero">
        <img src={`${base}Photos/pfp.jpg`} alt="Diehan Drotschie" class="about-photo" />
        <div>
            <p class="eyebrow">{hero.eyebrow}</p>
            <h2>{hero.headline}</h2>
            <p class="text-secondary">{hero.subhead}</p>
            <div class="about-tags">
                {hero.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
        </div>
    </div>

    <hr />

    <h3>Summary</h3>
    <p class="text-secondary">{about.summary}</p>

    <div class="about-facts">
        {
            about.facts.map(([label, value]) => (
                <div>
                    <p class="text-secondary fact-label">{label}</p>
                    <p class="fact-value">{value}</p>
                </div>
            ))
        }
    </div>
</div>

<style>
    .about-hero {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .about-photo {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 16px;
        flex-shrink: 0;
    }

    .about-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.75rem;
    }

    .about-facts {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .fact-label {
        margin: 0;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .fact-value {
        margin: 0.15rem 0 0;
        font-weight: 600;
    }
</style>
