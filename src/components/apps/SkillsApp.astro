---
import { skills } from "../../data/site.js";

const tools = new Set([
    ".NET",
    "Blazor",
    "Flutter",
    "React",
    "PixiJS",
    "Firebase",
    "PostgreSQL",
    "REST APIs",
    "Docker",
    "Git",
    "NUnit",
    "Postman",
]);
const cloud = new Set([
    "AWS API Gateway",
    "AWS Cognito",
    "AWS Step Functions",
    "AWS Lambda",
    "AWS S3",
    "AWS EC2",
    "AWS DynamoDB",
    "AWS Bedrock",
    "AWS SNS",
    "AWS SQS",
]);
const automation = new Set(["n8n"]);
const collaboration = new Set(["Agile", "Jira", "Confluence", "CI/CD"]);

const groups = [
    {
        title: "Languages",
        description:
            "Core languages behind coursework, personal projects, and production service code.",
        items: skills.filter(
            (s) => !cloud.has(s) && !tools.has(s) && !automation.has(s) && !collaboration.has(s),
        ),
        accent: "linear-gradient(160deg, #3a3f4a 0%, #15171c 100%)",
    },
    {
        title: "Frameworks & Tools",
        description:
            "Frameworks, a database, and the testing/versioning tooling used to build and ship reliable service code.",
        items: skills.filter((s) => tools.has(s)),
        accent: "linear-gradient(160deg, #6a7280 0%, #3a3f4a 100%)",
    },
    {
        title: "Cloud (AWS)",
        description:
            "AWS services used day-to-day to design, deploy, and scale backend services.",
        items: skills.filter((s) => cloud.has(s)),
        accent: "linear-gradient(160deg, #94a1b5 0%, #5a6478 100%)",
    },
    {
        title: "Automation",
        description: "Workflow automation for streamlining internal processes and integrations.",
        items: skills.filter((s) => automation.has(s)),
        accent: "linear-gradient(160deg, #ff9ecf 0%, #d6336c 100%)",
    },
    {
        title: "Agile & Collaboration",
        description: "Delivery process and tooling for planning, tracking, and shipping as a team.",
        items: skills.filter((s) => collaboration.has(s)),
        accent: "linear-gradient(160deg, #a5b4fc 0%, #4f46e5 100%)",
    },
];
---

<div class="app-content skills-app">
    <h2>Skills</h2>
    <p class="text-secondary skills-intro">
        A breakdown of the languages, frameworks, cloud services, and workflows I work with —
        grouped by area.
    </p>
    {
        groups.map(
            (group) =>
                group.items.length > 0 && (
                    <div class="skill-group reveal-rise">
                        <div class="skill-group-header">
                            <p class="skill-group-title">{group.title}</p>
                            <span class="skill-group-rule" style={`background:${group.accent}`} />
                        </div>
                        <p class="text-secondary skill-group-desc">{group.description}</p>
                        <div class="skills-grid">
                            {group.items.map((skill, i) => (
                                <div class="skill-tile reveal-rise" style={`--reveal-delay:${i * 45}ms`}>
                                    <span class="skill-glyph" style={`background:${group.accent}`}>
                                        {skill.slice(0, 2).toUpperCase()}
                                    </span>
                                    <span class="skill-name">{skill}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                ),
        )
    }
</div>

<style>
    .skills-intro {
        margin: -0.5rem 0 1.5rem;
        max-width: 46ch;
    }

    .skill-group {
        margin-bottom: 1.5rem;
    }

    .skill-group:last-child {
        margin-bottom: 0;
    }

    .skill-group-header {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin: 0 0 0.9rem;
    }

    .skill-group-title {
        margin: 0;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-secondary);
        white-space: nowrap;
    }

    .skill-group-rule {
        height: 2px;
        flex: 1;
        border-radius: 2px;
        opacity: 0.35;
    }

    .skill-group-desc {
        margin: -0.4rem 0 0.9rem;
        font-size: 0.82rem;
        max-width: 52ch;
    }

    .skills-grid {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        gap: 0.7rem 0.6rem;
    }

    .skill-tile {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.5rem 0.9rem 0.5rem 0.5rem;
        border-radius: 12px;
        background: rgba(21, 23, 28, 0.05);
        border: 1px solid rgba(21, 23, 28, 0.1);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.15s ease,
            border-color 0.15s ease;
    }

    .skill-tile:hover {
        transform: translateY(-4px) scale(1.04);
        box-shadow: 0 10px 20px rgba(21, 23, 28, 0.16);
        border-color: rgba(21, 23, 28, 0.22);
    }

    .skill-glyph {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        border-radius: 50%;
        color: #f4f1ec;
        font-family: var(--font-display);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .skill-tile:hover .skill-glyph {
        transform: rotate(-8deg) scale(1.08);
    }

    .skill-name {
        font-size: 0.9rem;
        font-weight: 500;
    }

    @media (prefers-reduced-motion: reduce) {
        .skill-tile,
        .skill-glyph {
            transition: none;
        }
    }
</style>
