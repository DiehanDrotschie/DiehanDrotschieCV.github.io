---
import { contact } from "../../data/site.js";
---

<div class="app-content contact-app">
    <div class="contact-hero reveal-rise">
        <span
            class="contact-glyph"
            set:html='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>'
        />
        <div>
            <h2>{contact.heading}</h2>
            <p class="text-secondary">{contact.subtext}</p>
        </div>
    </div>

    <div class="contact-cta-wrap reveal-rise" style="--reveal-delay:100ms">
        <a class="btn contact-cta" href={`mailto:${contact.email}`}>
            <span class="contact-cta-glow" aria-hidden="true"></span>
            <span
                class="contact-cta-icon"
                set:html='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>'
            />
            <span class="contact-cta-label">Email {contact.email}</span>
        </a>
    </div>
    <div class="contact-hint reveal-rise" style="--reveal-delay:180ms">
        <span
            class="contact-hint-icon"
            set:html='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 0 0 6 3.5l2-2a4 4 0 0 0-5.5-5.8"/><path d="M15 12a4 4 0 0 0-6-3.5l-2 2a4 4 0 0 0 5.5 5.8"/></svg>'
        />
        <p class="text-secondary">For LinkedIn and Email, open the Contact Links icon in the dock.</p>
    </div>
</div>

<style>
    .contact-hero {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .contact-hero h2 {
        margin: 0 0 0.25rem;
    }

    .contact-glyph {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        border-radius: 13px;
        background: linear-gradient(160deg, #6fe0a0 0%, #1fa35f 100%);
        color: white;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
    }

    .contact-glyph svg {
        width: 22px;
        height: 22px;
    }

    .contact-cta-wrap {
        display: inline-block;
        margin-top: 1.5rem;
    }

    /* Positioned relative to `.contact-cta` (its actual parent, since a
       markup change) rather than `.contact-cta-wrap` — needed so the glow
       hugs the button's real size even when it wraps onto two lines on
       mobile. Being an in-flow sibling of the icon/label spans is fine even
       though it's `position: absolute` and empty: it doesn't affect the
       flex layout of its siblings. */
    .contact-cta-glow {
        position: absolute;
        inset: -10px;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(31, 163, 95, 0.35), transparent 70%);
        animation: cta-pulse 2.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
        z-index: -1;
    }

    @keyframes cta-pulse {
        0%,
        100% {
            transform: scale(0.92);
            opacity: 0.7;
        }
        50% {
            transform: scale(1.12);
            opacity: 1;
        }
    }

    .contact-cta {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        max-width: 100%;
        background: linear-gradient(160deg, #6fe0a0 0%, #1fa35f 100%);
        color: white;
        box-shadow: 0 6px 16px rgba(31, 163, 95, 0.3);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.15s ease, opacity 0.15s ease;
    }

    /* Wraps the email onto a second line instead of overflowing once the
       label + full address don't fit the button's available width — needed
       specifically on mobile, where the window itself is much narrower
       (see sizeForMobile() in DesktopScript.astro) than the ~560px desktop
       default, leaving too little room for "Email <address>" on one line.
       `min-width: 0` is required for a flex item's content to actually
       shrink/wrap instead of the flex algorithm defaulting to its
       max-content (unwrapped) size and overflowing the button. */
    .contact-cta-label {
        min-width: 0;
        overflow-wrap: break-word;
    }

    .contact-cta:hover {
        transform: translateY(-2px) scale(1.03);
        box-shadow: 0 10px 22px rgba(31, 163, 95, 0.38);
    }

    @media (prefers-reduced-motion: reduce) {
        .contact-cta-glow {
            animation: none;
        }
    }

    .contact-cta-icon {
        display: inline-flex;
        width: 16px;
        height: 16px;
    }

    .contact-hint {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        margin-top: 1rem;
    }

    .contact-hint p {
        margin: 0;
        font-size: 0.85rem;
    }

    .contact-hint-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        flex-shrink: 0;
        margin-top: 0.05rem;
        border-radius: 8px;
        background: linear-gradient(160deg, #c9a6ff 0%, #7b4fe0 100%);
        color: white;
    }

    .contact-hint-icon svg {
        width: 14px;
        height: 14px;
    }

    /* Mobile windows are much narrower than desktop's (sizeForMobile() in
       DesktopScript.astro), so the CTA sat flush against the left edge with
       a lot of empty space to its right instead of looking centered — this
       centers it as a whole. `display: flex` (not `table`) is deliberate:
       `display: table` was tried first and doesn't work here — table
       auto-layout treats its content's unwrapped (max-content) width as a
       hard floor and ignores `max-width` rather than let a cell's content
       reflow/wrap, so the button never actually shrank and stayed
       overflowing. A flex container has no such floor — its child
       (`.contact-cta`, with its own `max-width: 100%`) genuinely shrinks
       and the email wraps onto a second line via `.contact-cta-label`'s
       `min-width: 0`, below. */
    @media (max-width: 900px), (pointer: coarse) {
        .contact-cta-wrap {
            display: flex;
            justify-content: center;
        }
    }
</style>
