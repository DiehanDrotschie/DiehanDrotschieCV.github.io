---
import { projects } from "../../data/site.js";

const base = import.meta.env.BASE_URL;
const featuredTitle = projects.reduce((a, b) =>
    b.images.length > a.images.length ? b : a,
).title;
---

<div class="app-content work-app">
    <h2>Portfolio</h2>
    <p class="text-secondary">These are some very basic projects I have worked on.</p>
    <div class="grid grid-2 project-grid">
        {
            projects.map((project, i) => (
                <button
                    type="button"
                    class:list={["card", "project-card", "reveal-rise", { "project-card-featured": project.title === featuredTitle }]}
                    style={`--reveal-delay:${i * 70}ms`}
                    data-images={project.images.map((img) => `${base}${img}`).join("|")}
                    data-title={project.title}
                >
                    <div class="project-thumb">
                        <img src={`${base}${project.images[0]}`} alt={project.title} />
                        {project.images.length > 1 && (
                            <span class="project-badge">{project.images.length} photos</span>
                        )}
                    </div>
                    <div class="project-body">
                        <h4>{project.title}</h4>
                        <p class="text-secondary">{project.description}</p>
                    </div>
                </button>
            ))
        }
    </div>

    <dialog class="gallery-dialog">
        <button type="button" class="gallery-close" aria-label="Close">&times;</button>
        <div class="gallery-main">
            <button type="button" class="gallery-nav gallery-prev" aria-label="Previous image">&#8249;</button>
            <img class="gallery-image" src="" alt="" />
            <button type="button" class="gallery-nav gallery-next" aria-label="Next image">&#8250;</button>
        </div>
        <div class="gallery-thumbs"></div>
        <p class="gallery-caption"></p>
    </dialog>
</div>

<style>
    .project-grid {
        margin-top: 1.5rem;
    }

    .project-card {
        position: relative;
        text-align: left;
        padding: 0;
        overflow: hidden;
        cursor: pointer;
        font: inherit;
        color: inherit;
        border-color: rgba(31, 143, 224, 0.16);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.15s ease, border-color 0.15s ease;
    }

    .project-card:hover {
        transform: translateY(-3px);
        border-color: rgba(31, 143, 224, 0.4);
        box-shadow: 0 12px 26px rgba(31, 143, 224, 0.22);
    }

    .project-card-featured {
        grid-column: span 2;
    }

    @media (max-width: 640px) {
        .project-card-featured {
            grid-column: span 1;
        }
    }

    .project-card-featured .project-thumb {
        height: 240px;
    }

    .project-thumb {
        position: relative;
        overflow: hidden;
    }

    .project-card img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        transition: transform 0.35s ease;
    }

    .project-card:hover img {
        transform: scale(1.04);
    }

    .project-card-featured .project-thumb img {
        height: 100%;
    }

    .project-badge {
        position: absolute;
        right: 0.6rem;
        bottom: 0.6rem;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        background: linear-gradient(160deg, #6fd0ff 0%, #1f8fe0 100%);
        color: white;
        font-size: 0.72rem;
        font-weight: 600;
        box-shadow: 0 4px 10px rgba(31, 143, 224, 0.35);
    }

    .project-body {
        padding: 1.1rem;
    }

    .gallery-dialog {
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 14px;
        padding: 0;
        max-width: min(90vw, 800px);
        background: rgba(16, 19, 24, 0.92);
        backdrop-filter: blur(24px) saturate(1.4);
        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55);
        color: white;
    }

    .gallery-dialog::backdrop {
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(4px);
    }

    .gallery-close {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 50%;
        color: white;
        font-size: 1.4rem;
        line-height: 1;
        cursor: pointer;
        transition: background 0.15s ease;
        z-index: 2;
    }

    .gallery-close:hover {
        background: rgba(255, 255, 255, 0.18);
    }

    .gallery-main {
        position: relative;
        display: flex;
        align-items: center;
    }

    .gallery-main img {
        width: 100%;
        max-height: 65vh;
        object-fit: contain;
        margin: 0 auto;
    }

    .gallery-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: white;
        font-size: 1.75rem;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        cursor: pointer;
        transition: background 0.15s ease;
        z-index: 2;
    }

    .gallery-nav:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.18);
    }

    .gallery-prev {
        left: 8px;
    }

    .gallery-next {
        right: 8px;
    }

    .gallery-nav:disabled {
        opacity: 0.3;
        cursor: default;
    }

    .gallery-thumbs {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem;
        flex-wrap: wrap;
    }

    .gallery-thumbs img {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 4px;
        cursor: pointer;
        opacity: 0.4;
        border: 2px solid transparent;
        transition: opacity 0.2s, border-color 0.2s;
    }

    .gallery-thumbs img.active {
        opacity: 1;
        border-color: white;
    }

    .gallery-caption {
        text-align: center;
        color: #bbb;
        font-size: 0.85rem;
        padding-bottom: 0.75rem;
        margin: 0;
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>(".work-app").forEach((root) => {
        const dialog = root.querySelector<HTMLDialogElement>(".gallery-dialog");
        const galleryImage = root.querySelector<HTMLImageElement>(".gallery-image");
        const galleryThumbs = root.querySelector<HTMLElement>(".gallery-thumbs");
        const galleryCaption = root.querySelector<HTMLElement>(".gallery-caption");
        const prevBtn = root.querySelector<HTMLButtonElement>(".gallery-prev");
        const nextBtn = root.querySelector<HTMLButtonElement>(".gallery-next");
        const closeBtn = root.querySelector<HTMLButtonElement>(".gallery-close");

        let images: string[] = [];
        let title = "";
        let index = 0;

        function render() {
            if (!galleryImage || !galleryCaption || !galleryThumbs) return;
            galleryImage.src = images[index];
            galleryImage.alt = `${title} image ${index + 1}`;
            galleryCaption.textContent = `${index + 1} / ${images.length}`;
            galleryThumbs.querySelectorAll("img").forEach((thumb, i) => {
                thumb.classList.toggle("active", i === index);
            });
            if (prevBtn) prevBtn.disabled = images.length <= 1;
            if (nextBtn) nextBtn.disabled = images.length <= 1;
        }

        function openGallery(newImages: string[], newTitle: string) {
            images = newImages;
            title = newTitle;
            index = 0;
            if (galleryThumbs) {
                galleryThumbs.replaceChildren();
                images.forEach((img, i) => {
                    const thumb = document.createElement("img");
                    thumb.src = img;
                    thumb.alt = `thumbnail ${i + 1}`;
                    thumb.addEventListener("click", () => {
                        index = i;
                        render();
                    });
                    galleryThumbs.appendChild(thumb);
                });
            }
            render();
            dialog?.showModal();
        }

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        root.querySelectorAll<HTMLButtonElement>(".project-card").forEach((card) => {
            card.addEventListener("click", () => {
                const imgs = (card.dataset.images ?? "").split("|").filter(Boolean);
                openGallery(imgs, card.dataset.title ?? "");
            });

            if (reduceMotion) return;
            const MAX_TILT = 5;
            card.addEventListener("mousemove", (e) => {
                const rect = card.getBoundingClientRect();
                const px = (e.clientX - rect.left) / rect.width - 0.5;
                const py = (e.clientY - rect.top) / rect.height - 0.5;
                card.style.transform = `perspective(700px) rotateX(${(-py * MAX_TILT).toFixed(2)}deg) rotateY(${(px * MAX_TILT).toFixed(2)}deg) translateY(-3px)`;
            });
            card.addEventListener("mouseleave", () => {
                card.style.transform = "";
            });
        });

        prevBtn?.addEventListener("click", () => {
            index = (index - 1 + images.length) % images.length;
            render();
        });

        nextBtn?.addEventListener("click", () => {
            index = (index + 1) % images.length;
            render();
        });

        closeBtn?.addEventListener("click", () => dialog?.close());

        dialog?.addEventListener("keydown", (e) => {
            if (e.key === "ArrowLeft") prevBtn?.click();
            if (e.key === "ArrowRight") nextBtn?.click();
        });

        dialog?.addEventListener("click", (e) => {
            if (e.target === dialog) dialog.close();
        });
    });
</script>
