---
import { navItems } from "../data/site.js";

const base = import.meta.env.BASE_URL;
---

<header class="navbar">
    <div class="container navbar-inner">
        <button
            class="nav-toggle"
            id="nav-toggle"
            aria-label="Open navigation"
            aria-expanded="false"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>
        <span class="brand">Diehan Drotschie</span>
        <nav class="nav-links">
            {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="btn btn-primary cv-btn" href={`${base}DiehanCV.pdf`} target="_blank" rel="noreferrer">
            Download CV
        </a>
    </div>
    <div class="mobile-drawer" id="mobile-drawer">
        <nav>
            {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
            <a class="btn btn-primary" href={`${base}DiehanCV.pdf`} target="_blank" rel="noreferrer">
                Download CV
            </a>
        </nav>
    </div>
</header>

<style>
    .navbar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(247, 243, 238, 0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
    }

    .navbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 0.85rem;
        padding-bottom: 0.85rem;
    }

    .brand {
        font-weight: 700;
        font-size: 1.1rem;
        margin-right: auto;
    }

    .nav-links {
        display: none;
        gap: 0.25rem;
    }

    .nav-links a {
        text-decoration: none;
        color: var(--text);
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        font-weight: 500;
    }

    .nav-links a:hover {
        background: rgba(29, 27, 22, 0.05);
    }

    .cv-btn {
        display: none;
    }

    .nav-toggle {
        display: inline-flex;
        flex-direction: column;
        gap: 4px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
    }

    .nav-toggle span {
        width: 22px;
        height: 2px;
        background: var(--text);
        display: block;
    }

    .mobile-drawer {
        display: none;
        flex-direction: column;
        padding: 1rem 1.5rem 1.5rem;
        border-bottom: 1px solid var(--border);
        background: var(--bg);
    }

    .mobile-drawer.open {
        display: flex;
    }

    .mobile-drawer nav {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .mobile-drawer a {
        text-decoration: none;
        color: var(--text);
        padding: 0.5rem 0;
        font-weight: 500;
    }

    @media (min-width: 768px) {
        .nav-toggle {
            display: none;
        }
        .nav-links {
            display: flex;
        }
        .cv-btn {
            display: inline-flex;
        }
        .mobile-drawer {
            display: none !important;
        }
    }
</style>

<script>
    const toggle = document.getElementById("nav-toggle");
    const drawer = document.getElementById("mobile-drawer");

    toggle?.addEventListener("click", () => {
        const isOpen = drawer?.classList.toggle("open");
        toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
    });

    drawer?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            drawer.classList.remove("open");
            toggle?.setAttribute("aria-expanded", "false");
        });
    });
</script>
