---
import { projects } from "../data/site.js";

const base = import.meta.env.BASE_URL;
---

<section id="work" class="section">
    <div class="container">
        <h2>Portfolio</h2>
        <p>These are some very basic projects I have worked on.</p>
        <div class="grid grid-2 project-grid">
            {
                projects.map((project) => (
                    <button
                        type="button"
                        class="card project-card"
                        data-images={project.images
                            .map((img) => `${base}${img}`)
                            .join("|")}
                        data-title={project.title}
                    >
                        <img src={`${base}${project.images[0]}`} alt={project.title} />
                        <div class="project-body">
                            <h4>{project.title}</h4>
                            <p class="text-secondary">{project.description}</p>
                            {project.images.length > 1 && (
                                <p class="text-secondary project-count">
                                    {project.images.length} images — click to view gallery
                                </p>
                            )}
                        </div>
                    </button>
                ))
            }
        </div>
    </div>
</section>

<dialog id="gallery-dialog" class="gallery-dialog">
    <button type="button" class="gallery-close" id="gallery-close" aria-label="Close">
        &times;
    </button>
    <div class="gallery-main">
        <button type="button" class="gallery-nav gallery-prev" id="gallery-prev" aria-label="Previous image">
            &#8249;
        </button>
        <img id="gallery-image" src="" alt="" />
        <button type="button" class="gallery-nav gallery-next" id="gallery-next" aria-label="Next image">
            &#8250;
        </button>
    </div>
    <div class="gallery-thumbs" id="gallery-thumbs"></div>
    <p class="gallery-caption" id="gallery-caption"></p>
</dialog>

<style>
    .project-grid {
        margin-top: 2rem;
    }

    .project-card {
        text-align: left;
        padding: 0;
        overflow: hidden;
        cursor: pointer;
        font: inherit;
        color: inherit;
        transition: opacity 0.15s ease;
    }

    .project-card:hover {
        opacity: 0.9;
    }

    .project-card img {
        width: 100%;
        height: 220px;
        object-fit: cover;
    }

    .project-body {
        padding: 1.5rem;
    }

    .project-count {
        font-size: 0.85rem;
        margin: 0;
    }

    .gallery-dialog {
        border: none;
        border-radius: 12px;
        padding: 0;
        max-width: min(90vw, 800px);
        background: black;
        color: white;
    }

    .gallery-dialog::backdrop {
        background: rgba(0, 0, 0, 0.7);
    }

    .gallery-close {
        position: absolute;
        top: 8px;
        right: 8px;
        background: none;
        border: none;
        color: white;
        font-size: 1.75rem;
        line-height: 1;
        cursor: pointer;
        z-index: 2;
    }

    .gallery-main {
        position: relative;
        display: flex;
        align-items: center;
    }

    .gallery-main img {
        width: 100%;
        max-height: 70vh;
        object-fit: contain;
        margin: 0 auto;
    }

    .gallery-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0, 0, 0, 0.4);
        border: none;
        color: white;
        font-size: 1.75rem;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        cursor: pointer;
        z-index: 2;
    }

    .gallery-prev {
        left: 8px;
    }

    .gallery-next {
        right: 8px;
    }

    .gallery-nav:disabled {
        opacity: 0.3;
        cursor: default;
    }

    .gallery-thumbs {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem;
        flex-wrap: wrap;
    }

    .gallery-thumbs img {
        width: 56px;
        height: 56px;
        object-fit: cover;
        border-radius: 4px;
        cursor: pointer;
        opacity: 0.4;
        border: 2px solid transparent;
        transition: opacity 0.2s, border-color 0.2s;
    }

    .gallery-thumbs img.active {
        opacity: 1;
        border-color: white;
    }

    .gallery-caption {
        text-align: center;
        color: #bbb;
        font-size: 0.85rem;
        padding-bottom: 0.75rem;
        margin: 0;
    }
</style>

<script>
    const dialog = document.getElementById("gallery-dialog") as HTMLDialogElement | null;
    const galleryImage = document.getElementById("gallery-image") as HTMLImageElement | null;
    const galleryThumbs = document.getElementById("gallery-thumbs");
    const galleryCaption = document.getElementById("gallery-caption");
    const prevBtn = document.getElementById("gallery-prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("gallery-next") as HTMLButtonElement | null;
    const closeBtn = document.getElementById("gallery-close");

    let images: string[] = [];
    let title = "";
    let index = 0;

    function render() {
        if (!galleryImage || !galleryCaption || !galleryThumbs) return;
        galleryImage.src = images[index];
        galleryImage.alt = `${title} image ${index + 1}`;
        galleryCaption.textContent = `${index + 1} / ${images.length}`;
        galleryThumbs.querySelectorAll("img").forEach((thumb, i) => {
            thumb.classList.toggle("active", i === index);
        });
        if (prevBtn) prevBtn.disabled = images.length <= 1;
        if (nextBtn) nextBtn.disabled = images.length <= 1;
    }

    function openGallery(newImages: string[], newTitle: string) {
        images = newImages;
        title = newTitle;
        index = 0;
        if (galleryThumbs) {
            galleryThumbs.replaceChildren();
            images.forEach((img, i) => {
                const thumb = document.createElement("img");
                thumb.src = img;
                thumb.alt = `thumbnail ${i + 1}`;
                thumb.addEventListener("click", () => {
                    index = i;
                    render();
                });
                galleryThumbs.appendChild(thumb);
            });
        }
        render();
        dialog?.showModal();
    }

    document.querySelectorAll<HTMLButtonElement>(".project-card").forEach((card) => {
        card.addEventListener("click", () => {
            const imgs = (card.dataset.images ?? "").split("|").filter(Boolean);
            openGallery(imgs, card.dataset.title ?? "");
        });
    });

    prevBtn?.addEventListener("click", () => {
        index = (index - 1 + images.length) % images.length;
        render();
    });

    nextBtn?.addEventListener("click", () => {
        index = (index + 1) % images.length;
        render();
    });

    closeBtn?.addEventListener("click", () => dialog?.close());

    dialog?.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") prevBtn?.click();
        if (e.key === "ArrowRight") nextBtn?.click();
    });

    dialog?.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
    });
</script>
