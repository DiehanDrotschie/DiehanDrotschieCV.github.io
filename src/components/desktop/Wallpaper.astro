---
const base = import.meta.env.BASE_URL;
---

<div class="wallpaper" aria-hidden="true">
    <img
        src={`${base}Photos/wallpaper-hills.jpg`}
        alt=""
        class="wallpaper-photo"
        fetchpriority="high"
    />
    <div class="wallpaper-scrim"></div>
</div>

<style>
    .wallpaper {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
    }

    .wallpaper-photo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    /* A light top/bottom scrim keeps the menu bar and dock legible against
       whatever part of the photo (bright sky, dark foliage) sits behind
       them, without dimming the photo itself in the middle of the screen. */
    .wallpaper-scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.22) 0%,
            rgba(0, 0, 0, 0) 14%,
            rgba(0, 0, 0, 0) 82%,
            rgba(0, 0, 0, 0.28) 100%
        );
    }
</style>
