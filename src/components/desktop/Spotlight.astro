---
import { apps } from "../../data/apps.js";
---

<div class="spotlight-overlay" id="spotlight-overlay">
    <div class="spotlight-box">
        <div class="spotlight-search-row">
            <svg class="spotlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input
                type="text"
                class="spotlight-input"
                id="spotlight-input"
                placeholder="Search About, Skills, Portfolio, Resume…"
                autocomplete="off"
            />
        </div>
        <div class="spotlight-results" id="spotlight-results">
            {
                apps.filter((app) => !app.links).map((app) => (
                    <button
                        type="button"
                        class="spotlight-result"
                        data-open={app.id}
                        data-label={app.title.toLowerCase()}
                    >
                        <span class="spotlight-result-icon" style={`background:${app.gradient}`} set:html={app.icon} />
                        <span>{app.title}</span>
                    </button>
                ))
            }
        </div>
    </div>
</div>
