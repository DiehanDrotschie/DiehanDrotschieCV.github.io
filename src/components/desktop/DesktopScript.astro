---
import { apps } from "../../data/apps.js";

const appMeta = apps
    .filter((app) => !app.links)
    .map(({ id, width, height, openOnLoad }) => ({
        id,
        width,
        height,
        openOnLoad: Boolean(openOnLoad),
    }));
---

<script define:vars={{ appMeta }}>
    const MOBILE_QUERY = "(max-width: 900px), (pointer: coarse)";
    let zIndexCounter = 10;
    let openOffset = 0;
    let wasMobile = false;

    const minimizedIds = new Set();
    const maximizedIds = new Set();
    const restoreBounds = new Map();

    // Scroll-reveal: every app's content fades/rises into place the first
    // time it scrolls into view inside its window's scrolling body. One
    // shared checker for all apps — the pattern (and the reduced-motion
    // escape hatch) is identical everywhere, so it doesn't belong per-app.
    //
    // IntersectionObserver is the primary mechanism (cheap, browser-native,
    // zero per-scroll-frame JS cost) and correctly respects clipping by a
    // `.window-body`'s own scroll — modern browsers clip intersection by all
    // scrolling ancestors between the target and the implicit (viewport)
    // root, not just the target/root pair directly.
    //
    // `revealVisible()`/`isInView()` below are a manual getBoundingClientRect
    // fallback, used ONLY when IntersectionObserver isn't available (rare in
    // 2026) or its callback never actually arrives — confirmed by direct
    // test that this project's sandboxed Browser pane never composites a
    // frame, so IO callbacks never fire there even though the API exists.
    // Earlier this fallback was wired to a raw, unthrottled `scroll` listener
    // that ran a full getBoundingClientRect() pass on every scroll event —
    // real, measurable jank on every visitor's machine to accommodate a test
    // tool's quirk. It's now direct-call-only (window open/restore/maximize,
    // where a call is cheap because it only runs on those actions, not every
    // scroll frame) plus one initial check — it does NOT attach scroll/resize
    // listeners. Don't re-add unthrottled scroll listeners here; if IO ever
    // needs a broader safety net, throttle it (rAF-gated) rather than running
    // on every raw scroll/resize event.
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function isInView(el) {
        const rect = el.getBoundingClientRect();
        if (rect.bottom <= 0 || rect.top >= window.innerHeight) return false;
        if (rect.right <= 0 || rect.left >= window.innerWidth) return false;
        // Also respect clipping by the window's own scrolling body — a raw
        // viewport check alone would reveal content that's actually scrolled
        // out of sight above/below a window's visible area.
        const scroller = el.closest(".window-body");
        if (scroller) {
            const sRect = scroller.getBoundingClientRect();
            if (rect.bottom <= sRect.top || rect.top >= sRect.bottom) return false;
        }
        return true;
    }

    function revealVisible() {
        if (reduceMotion) return;
        document
            .querySelectorAll(".reveal:not(.is-visible), .reveal-rise:not(.is-visible)")
            .forEach((el) => {
                if (isInView(el)) el.classList.add("is-visible");
            });
    }

    let revealObserver = null;
    if (!reduceMotion && "IntersectionObserver" in window) {
        revealObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add("is-visible");
                    revealObserver.unobserve(entry.target);
                });
            },
            { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
        );
    }

    function isMobile() {
        return window.matchMedia(MOBILE_QUERY).matches;
    }

    function getWindow(id) {
        return document.querySelector(`.window[data-app="${id}"]`);
    }

    function getDockItem(id) {
        return document.querySelector(`.dock-item[data-open="${id}"]`);
    }

    function focusWindow(win) {
        zIndexCounter += 1;
        win.style.zIndex = String(zIndexCounter);
    }

    function setDockActive(id, active) {
        document
            .querySelectorAll(`[data-open="${id}"].dock-item`)
            .forEach((el) => el.classList.toggle("active", active));
    }

    function sizeForMobile(win) {
        win.style.left = "10px";
        win.style.top = "50px";
        win.style.width = "calc(100vw - 88px)";
        win.style.height = "calc(100vh - 84px)";
        win.style.transform = "none";
    }

    function sizeForDesktop(win, id) {
        const meta = appMeta.find((a) => a.id === id);
        const width = meta?.width ?? 560;
        const height = meta?.height ?? 420;
        win.style.width = `${width}px`;
        win.style.height = `${height}px`;
        const left = Math.max(20, window.innerWidth / 2 - width / 2 + openOffset);
        const top = Math.max(60, 90 + openOffset);
        win.style.left = `${left}px`;
        win.style.top = `${top}px`;
        win.style.transform = "none";
        openOffset = (openOffset + 28) % 140;
    }

    // animationend never fires if the animation didn't run (prefers-reduced-motion
    // sets `animation: none`, or this environment simply never paints a frame) —
    // race it against a timeout so state transitions always complete.
    function onAnimationSettled(el, fallbackMs, cb) {
        let done = false;
        const finish = () => {
            if (done) return;
            done = true;
            el.removeEventListener("animationend", finish);
            cb();
        };
        el.addEventListener("animationend", finish, { once: true });
        window.setTimeout(finish, fallbackMs);
    }

    function clearWindowState(id) {
        minimizedIds.delete(id);
        maximizedIds.delete(id);
        restoreBounds.delete(id);
        getDockItem(id)?.classList.remove("minimized");
        getWindow(id)?.classList.remove("maximized", "minimizing", "restoring", "bounds-animating");
    }

    function openWindow(id) {
        const win = getWindow(id);
        if (!win) return;

        if (minimizedIds.has(id)) {
            restoreMinimized(id);
            return;
        }

        if (isMobile()) {
            // One window at a time on mobile — keep things simple and full-screen.
            document.querySelectorAll(".window.open").forEach((w) => {
                if (w !== win) {
                    w.classList.remove("open");
                    w.style.display = "none";
                    setDockActive(w.getAttribute("data-app"), false);
                }
            });
            sizeForMobile(win);
        } else if (win.style.display !== "flex") {
            sizeForDesktop(win, id);
        }

        win.classList.add("open");
        win.style.display = "flex";
        focusWindow(win);
        setDockActive(id, true);
        revealVisible();
    }

    function closeWindow(id) {
        const win = getWindow(id);
        if (!win) return;
        win.classList.remove("open");
        win.style.display = "none";
        setDockActive(id, false);
        clearWindowState(id);
    }

    function toggleWindow(id) {
        const win = getWindow(id);
        if (!win) return;
        if (minimizedIds.has(id)) {
            restoreMinimized(id);
        } else if (win.style.display === "flex") {
            closeWindow(id);
        } else {
            openWindow(id);
        }
    }

    function minimizeWindow(id) {
        const win = getWindow(id);
        if (!win || win.style.display !== "flex" || minimizedIds.has(id)) return;

        const dockIcon = getDockItem(id)?.querySelector(".dock-icon");
        const winRect = win.getBoundingClientRect();
        if (dockIcon) {
            const dockRect = dockIcon.getBoundingClientRect();
            const dx = dockRect.left + dockRect.width / 2 - (winRect.left + winRect.width / 2);
            const dy = dockRect.top + dockRect.height / 2 - (winRect.top + winRect.height / 2);
            win.style.setProperty("--minimize-dx", `${dx}px`);
            win.style.setProperty("--minimize-dy", `${dy}px`);
        }

        minimizedIds.add(id);
        getDockItem(id)?.classList.add("minimized");
        win.classList.add("minimizing");

        onAnimationSettled(win, 360, () => {
            win.classList.remove("minimizing", "open");
            win.style.display = "none";
        });
    }

    function restoreMinimized(id) {
        const win = getWindow(id);
        if (!win) return;
        minimizedIds.delete(id);
        getDockItem(id)?.classList.remove("minimized");
        win.style.display = "flex";
        win.classList.add("open", "restoring");
        focusWindow(win);
        setDockActive(id, true);
        revealVisible();
        onAnimationSettled(win, 360, () => win.classList.remove("restoring"));
    }

    function getDesktopBounds() {
        const menuBar = document.querySelector(".menu-bar");
        const menuHeight = menuBar ? menuBar.getBoundingClientRect().height : 58;
        const margin = 14;
        return {
            left: margin,
            top: menuHeight + margin,
            width: Math.max(320, window.innerWidth - margin * 2),
            height: Math.max(220, window.innerHeight - menuHeight - margin * 2),
        };
    }

    function animateBounds(win, apply) {
        win.classList.add("bounds-animating");
        apply();
        window.setTimeout(() => win.classList.remove("bounds-animating"), 300);
    }

    // Shared by titlebar dragging and every resize handle below — both are
    // "follow the pointer from mousedown to mouseup" gestures that otherwise
    // duplicated the same boilerplate. Attaching the mousemove/mouseup pair
    // only for the duration of one drag (instead of once per handle, always
    // listening) also matters at scale here: with 8 resize handles per
    // window, a permanently-attached pair per handle would mean dozens of
    // idle `window`-level listeners doing an early-return check on every
    // mouse move across the whole page, for every window that exists.
    function trackPointer(onMove, onUp) {
        function move(e) {
            onMove(e);
        }
        function up(e) {
            window.removeEventListener("mousemove", move);
            window.removeEventListener("mouseup", up);
            onUp?.(e);
        }
        window.addEventListener("mousemove", move);
        window.addEventListener("mouseup", up);
    }

    function maximizeWindow(id) {
        const win = getWindow(id);
        if (!win || isMobile() || win.style.display !== "flex") return;

        if (maximizedIds.has(id)) {
            const bounds = restoreBounds.get(id);
            maximizedIds.delete(id);
            win.classList.remove("maximized");
            if (bounds) {
                animateBounds(win, () => {
                    win.style.left = `${bounds.left}px`;
                    win.style.top = `${bounds.top}px`;
                    win.style.width = `${bounds.width}px`;
                    win.style.height = `${bounds.height}px`;
                });
            }
        } else {
            restoreBounds.set(id, {
                left: win.offsetLeft,
                top: win.offsetTop,
                width: win.offsetWidth,
                height: win.offsetHeight,
            });
            maximizedIds.add(id);
            win.classList.add("maximized");
            const b = getDesktopBounds();
            animateBounds(win, () => {
                win.style.left = `${b.left}px`;
                win.style.top = `${b.top}px`;
                win.style.width = `${b.width}px`;
                win.style.height = `${b.height}px`;
            });
        }
        focusWindow(win);
        revealVisible();
    }

    // Dock + menu bar open triggers
    document.querySelectorAll("[data-open]").forEach((el) => {
        el.addEventListener("click", () => {
            const id = el.getAttribute("data-open");
            if (!id) return;
            if (el.classList.contains("dock-item")) {
                toggleWindow(id);
            } else {
                openWindow(id);
            }
            const overlay = document.getElementById("spotlight-overlay");
            overlay?.classList.remove("open");
        });
    });

    // Contact Links dock flyout. Hover-only on desktop by design (see
    // desktop.css's `.hover-open` comment) — click-to-toggle was removed
    // there as redundant next to hover. But touch devices have no hover at
    // all, so a hover-only trigger left the flyout completely unreachable
    // on mobile (confirmed: tapping did nothing, not even a flash). Click
    // is re-added here, gated to `(hover: none)` so it only ever fires on
    // devices that have no other way to open the flyout — desktop mice
    // still get click-does-nothing, hover-to-open exactly as before.
    const noHover = window.matchMedia("(hover: none)").matches;

    document.querySelectorAll(".dock-item-links").forEach((item) => {
        const trigger = item.querySelector(".dock-trigger");

        if (noHover) {
            trigger?.addEventListener("click", (e) => {
                e.stopPropagation();
                const isOpen = item.classList.contains("open");
                document
                    .querySelectorAll(".dock-item-links.open")
                    .forEach((el) => el.classList.remove("open"));
                item.classList.toggle("open", !isOpen);
            });
        }

        // Hover, with a debounced close instead of raw CSS :hover. The
        // flyout sits 14px above the dock icon with nothing rendered in
        // between (see the `.hover-open` comment in desktop.css) — moving
        // the cursor from icon to flyout crosses that empty gap, which
        // means the pointer briefly isn't over the icon OR the flyout and
        // a plain :hover would snap shut (and go unclickable) right there.
        // mouseenter/mouseleave on `item` still fire correctly for the gap
        // crossing (leaving on entering the gap, re-entering on reaching
        // the flyout, since it's a DOM descendant of `item`); the delay
        // just gives that crossing time to complete before actually closing.
        let hoverCloseTimer = null;
        item.addEventListener("mouseenter", () => {
            if (hoverCloseTimer) {
                window.clearTimeout(hoverCloseTimer);
                hoverCloseTimer = null;
            }
            item.classList.add("hover-open");
        });
        item.addEventListener("mouseleave", () => {
            if (hoverCloseTimer) window.clearTimeout(hoverCloseTimer);
            hoverCloseTimer = window.setTimeout(() => {
                item.classList.remove("hover-open");
                hoverCloseTimer = null;
                // A click focuses the trigger natively (it's a <button>),
                // and `:focus-within` is also part of the CSS rule that
                // shows the flyout (kept for keyboard/tab users) — without
                // this the flyout would keep it open on-screen after the
                // mouse leaves, only closing once something else is
                // clicked, since focus alone was enough to satisfy the
                // `:focus-within` half of that CSS rule.
                if (item.contains(document.activeElement)) trigger?.blur();
            }, 250);
        });
    });

    // Touch has no mouseleave to auto-close the flyout once `.open`, so a
    // tap anywhere outside it needs to close it explicitly — otherwise it
    // stays open on-screen until the visitor happens to tap the trigger
    // again. Desktop's hover-close (above) already handles its own case and
    // never sets `.open`, so this is a no-op there.
    document.addEventListener("click", (e) => {
        document.querySelectorAll(".dock-item-links.open").forEach((item) => {
            if (!item.contains(e.target)) item.classList.remove("open");
        });
    });

    // Window close / minimize / maximize / bring-to-front / dragging / resizing
    document.querySelectorAll(".window").forEach((win) => {
        const id = win.getAttribute("data-app");
        const titlebar = win.querySelector(".window-titlebar");
        const closeBtn = win.querySelector(".window-dot.close");
        const minimizeBtn = win.querySelector(".window-dot.minimize");
        const zoomBtn = win.querySelector(".window-dot.zoom");

        win.addEventListener("mousedown", () => focusWindow(win));

        closeBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            if (id) closeWindow(id);
        });

        minimizeBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            if (id) minimizeWindow(id);
        });

        zoomBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            if (id) maximizeWindow(id);
        });

        if (titlebar) {
            titlebar.addEventListener("mousedown", (e) => {
                if (isMobile() || e.target.closest(".window-dot")) return;
                let startX = e.clientX;
                let startY = e.clientY;
                let startLeft = win.offsetLeft;
                let startTop = win.offsetTop;
                focusWindow(win);
                e.preventDefault();

                trackPointer((e) => {
                    // Dragging a maximized window un-maximizes it first, like
                    // macOS — restore its pre-maximize size so the drag
                    // doesn't start by dragging the full-desktop-sized window
                    // around.
                    if (id && maximizedIds.has(id)) {
                        maximizedIds.delete(id);
                        win.classList.remove("maximized", "bounds-animating");
                        const bounds = restoreBounds.get(id);
                        const width = bounds?.width ?? win.offsetWidth;
                        const height = bounds?.height ?? win.offsetHeight;
                        win.style.width = `${width}px`;
                        win.style.height = `${height}px`;
                        startLeft = e.clientX - width / 2;
                        startTop = 40;
                        startX = e.clientX;
                        startY = e.clientY;
                    }
                    const dx = e.clientX - startX;
                    const dy = e.clientY - startY;
                    const maxLeft = window.innerWidth - 120;
                    const maxTop = window.innerHeight - 60;
                    win.style.left = `${Math.min(Math.max(0, startLeft + dx), maxLeft)}px`;
                    win.style.top = `${Math.min(Math.max(32, startTop + dy), maxTop)}px`;
                });
            });

            titlebar.addEventListener("dblclick", (e) => {
                if (isMobile() || e.target.closest(".window-dot")) return;
                if (id) maximizeWindow(id);
            });
        }

        // Resize handles — one generic handler per edge/corner.
        const MIN_WIDTH = 320;
        const MIN_HEIGHT = 220;
        win.querySelectorAll(".resize-handle").forEach((handle) => {
            const edge = handle.getAttribute("data-edge") ?? "";

            handle.addEventListener("mousedown", (e) => {
                if (isMobile()) return;
                const startX = e.clientX;
                const startY = e.clientY;
                const startLeft = win.offsetLeft;
                const startTop = win.offsetTop;
                const startWidth = win.offsetWidth;
                const startHeight = win.offsetHeight;
                if (id && maximizedIds.has(id)) {
                    maximizedIds.delete(id);
                    win.classList.remove("maximized", "bounds-animating");
                }
                focusWindow(win);
                e.preventDefault();
                e.stopPropagation();

                trackPointer((e) => {
                    const dx = e.clientX - startX;
                    const dy = e.clientY - startY;
                    let left = startLeft;
                    let top = startTop;
                    let width = startWidth;
                    let height = startHeight;

                    if (edge.includes("e")) width = Math.max(MIN_WIDTH, startWidth + dx);
                    if (edge.includes("s")) height = Math.max(MIN_HEIGHT, startHeight + dy);
                    if (edge.includes("w")) {
                        width = Math.max(MIN_WIDTH, startWidth - dx);
                        left = startLeft + (startWidth - width);
                    }
                    if (edge.includes("n")) {
                        height = Math.max(MIN_HEIGHT, startHeight - dy);
                        top = Math.max(32, startTop + (startHeight - height));
                    }

                    win.style.left = `${left}px`;
                    win.style.top = `${top}px`;
                    win.style.width = `${width}px`;
                    win.style.height = `${height}px`;
                });
            });
        });
    });

    // Keep windows sized correctly when crossing the mobile/desktop breakpoint,
    // and keep maximized windows filling the (possibly-resized) desktop area.
    // Manual drag/resize sizes are left alone otherwise — a plain viewport
    // resize on desktop shouldn't fight a size the visitor chose deliberately.
    wasMobile = isMobile();
    window.addEventListener("resize", () => {
        const nowMobile = isMobile();
        if (nowMobile !== wasMobile) {
            document.querySelectorAll(".window.open").forEach((win) => {
                if (nowMobile) {
                    sizeForMobile(win);
                } else {
                    sizeForDesktop(win, win.getAttribute("data-app"));
                }
            });
            wasMobile = nowMobile;
            return;
        }
        if (!nowMobile) {
            maximizedIds.forEach((id) => {
                const win = getWindow(id);
                if (!win) return;
                const b = getDesktopBounds();
                win.style.left = `${b.left}px`;
                win.style.top = `${b.top}px`;
                win.style.width = `${b.width}px`;
                win.style.height = `${b.height}px`;
            });
        }
    });

    // Spotlight
    const overlay = document.getElementById("spotlight-overlay");
    const input = document.getElementById("spotlight-input");
    const trigger = document.getElementById("spotlight-trigger");

    function openSpotlight() {
        overlay?.classList.add("open");
        input?.focus();
        if (input instanceof HTMLInputElement) input.value = "";
        filterResults("");
    }

    function closeSpotlight() {
        overlay?.classList.remove("open");
    }

    function filterResults(query) {
        const q = query.trim().toLowerCase();
        document.querySelectorAll(".spotlight-result").forEach((el) => {
            const label = el.getAttribute("data-label") ?? "";
            el.style.display = label.includes(q) ? "flex" : "none";
        });
    }

    trigger?.addEventListener("click", openSpotlight);

    overlay?.addEventListener("click", (e) => {
        if (e.target === overlay) closeSpotlight();
    });

    input?.addEventListener("input", (e) => {
        if (e.target instanceof HTMLInputElement) filterResults(e.target.value);
    });

    // "⌘" only makes sense on an actual Mac keyboard — everyone else (the
    // vast majority of visitors, given this is a portfolio) uses Ctrl for
    // the same shortcuts. iPhone/iPad report "Macintosh"-adjacent strings in
    // some UA forms too, so explicitly excluded — they don't have a Command
    // key either. Runs once on load; a brief flash of "⌘" before this swaps
    // the text is an acceptable tradeoff for a decorative hint (same as the
    // clock's blank first frame).
    const isRealMac = /Macintosh/.test(navigator.userAgent) && !/iPhone|iPad|iPod/.test(navigator.userAgent);
    if (!isRealMac) {
        document.querySelectorAll(".mod-key").forEach((el) => {
            el.textContent = `Ctrl+${el.getAttribute("data-key") ?? ""}`;
        });
    }

    document.addEventListener("keydown", (e) => {
        const target = e.target;
        const isTyping =
            target instanceof HTMLElement &&
            (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.isContentEditable);

        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
            e.preventDefault();
            if (overlay?.classList.contains("open")) {
                closeSpotlight();
            } else {
                openSpotlight();
            }
        }
        // Ctrl/Cmd+C is also the universal "copy" shortcut — only treat it as
        // "open Contact" when there's no text selected and the visitor isn't
        // typing/focused in a field, so copying a selected email address or
        // any other page text still works normally instead of being hijacked.
        if (
            (e.metaKey || e.ctrlKey) &&
            e.key.toLowerCase() === "c" &&
            !isTyping &&
            !window.getSelection()?.toString()
        ) {
            e.preventDefault();
            closeSpotlight();
            openWindow("contact");
        }
        if (e.key === "Escape") {
            closeSpotlight();
            document
                .querySelectorAll(".dock-item-links.hover-open, .dock-item-links.open")
                .forEach((el) => el.classList.remove("hover-open", "open"));
        }
    });

    // Open default windows on load
    appMeta.filter((a) => a.openOnLoad).forEach((a) => openWindow(a.id));

    // Wire up scroll-reveal: hand every `.reveal`/`.reveal-rise` element to
    // the IntersectionObserver (fires automatically on scroll AND on a
    // window's display:none→flex transition when it opens — no manual
    // per-window wiring needed for that). No scroll/resize listeners are
    // attached here — see the comment above `revealObserver` for why that
    // was deliberately removed. The one `revealVisible()` call below is a
    // single synchronous pass so already-visible content (e.g. the
    // `openOnLoad` window above) shows immediately rather than waiting on
    // IO's slight async delay, and so the sandboxed test Browser pane (where
    // IO callbacks never arrive) still has a working initial reveal.
    if (revealObserver) {
        document
            .querySelectorAll(".reveal, .reveal-rise")
            .forEach((el) => revealObserver.observe(el));
    }
    revealVisible();
</script>
