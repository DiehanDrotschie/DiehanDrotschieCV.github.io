---
import { apps } from "../../data/apps.js";
---

<div class="dock">
    {
        apps.map((app) => (
            <button
                type="button"
                class="dock-item"
                data-open={app.id}
                title={app.title}
                aria-label={app.title}
            >
                <span class="dock-icon" style={`background:${app.gradient}`} set:html={app.icon} />
                <span class="dock-label">{app.title}</span>
            </button>
        ))
    }
</div>
