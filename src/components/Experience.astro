---
import { experience } from "../data/site.js";
---

<section id="experience" class="section-tight">
    <div class="container">
        <h2>Experience</h2>
        <div class="card">
            {
                experience.map((item, i) => (
                    <>
                        <h4>{item.role}</h4>
                        <p class="text-secondary">{item.period}</p>
                        <p>{item.description}</p>
                        {item.extra && <p>{item.extra}</p>}
                        {i < experience.length - 1 && <hr />}
                    </>
                ))
            }
        </div>
    </div>
</section>
